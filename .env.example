# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (type: iOS or Android, matching app.json's bundleIdentifier/package).
# Enable the "Google Drive API" on the same project first.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# Dropbox App Console (dropbox.com/developers/apps) → your app → Settings.
# Permission type: Scoped app. Enable scopes: files.content.write,
# files.content.read, sharing.write, account_info.read.
EXPO_PUBLIC_DROPBOX_CLIENT_ID=

# Optional — only needed for cross-device share history. Supabase project
# URL + anon key (Project Settings → API). Leave blank to skip history.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
